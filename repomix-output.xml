  "message": "下單成功",
  "id": 1,
  "customerName": "王小明",
  "phone": "0912345678",
  "lineId": "wang_dessert",
  "subtotal": 295,
  "shippingFee": 60,
  "totalAmount": 355,
  "orderTime": "2026-07-17T10:30:00",
  "items": [
    { "dessertId": 1001, "dessertName": "70% 苦甜巧克力布朗尼", "unitPrice": 120, "quantity": 2, "lineTotal": 240 },
    { "dessertId": 1002, "dessertName": "法式馬卡龍", "unitPrice": 55, "quantity": 1, "lineTotal": 55 }
  ]
